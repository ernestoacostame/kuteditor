pkgname=kuteditor
pkgver=2.48 
pkgrel=1
pkgdesc="Editor de podcast con soporte JACK y Qt6"
arch=('x86_64')
url="https://www.kuteditor.com"
license=('GPL-3.0-or-later')

# Dependencias del sistema (usamos 'jack' genérico para compatibilidad PipeWire/JACK)
depends=('qt6-base' 'qt6-declarative' 'qt6-shadertools' 'jack' 'rnnoise' 'libsamplerate' 'taglib') 
makedepends=('cmake' 'ninja')

# Al estar en la carpeta del proyecto, no necesitamos fuentes externas
source=()
sha256sums=()

build() {
    # Usamos $startdir para referenciar donde está el CMakeLists.txt
    cmake -B build -S "$startdir" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DHAVE_WHISPER=OFF \
        -DHAVE_KUTPOD=ON \
        -G Ninja
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
